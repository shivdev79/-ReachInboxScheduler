PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/reachinbox_db?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

# Google OAuth 2.0 Credentials (Authorization Code Flow)
# Register this exact callback URL in Google Cloud Console:
# http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# JWT Auth Secret (for httpOnly auth_token cookie signing)
JWT_SECRET=replace_with_a_unique_random_secret

# Slack OAuth 2.0 app credentials; register this callback in Slack API settings.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

# Elasticsearch Configuration
ELASTICSEARCH_NODE=http://localhost:9200

# Concurrency & Provider Throttling Settings
WORKER_CONCURRENCY=3
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=5
SMTP_MODE=ethereal
SMTP_STUB_LATENCY_MS=0
SMTP_TEST_PAUSE_BEFORE_MESSAGE_ID_MS=0
SMTP_TEST_PAUSE_AFTER_MESSAGE_ID_MS=0
SENDING_RECOVERY_TIMEOUT_MS=30000
BULLMQ_LOCK_DURATION_MS=30000
BULLMQ_LOCK_RENEW_TIME_MS=15000
BULLMQ_STALLED_INTERVAL_MS=1000

# Ethereal Email Credentials
ETHEREAL_USER=
ETHEREAL_PASS=

