datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String   @id @default(uuid())
  googleId        String?  @unique @map("google_id")
  email           String   @unique
  name            String
  avatarUrl       String?  @map("avatar_url")
  passwordHash    String?  @map("password_hash")
  slackWebhookUrl String?  @map("slack_webhook_url")
  slackConnected  Boolean  @default(false) @map("slack_connected")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  emails          Email[]

  @@map("users")
}

model Sender {
  id          String   @id @default(uuid())
  email       String   @unique
  name        String
  hourlyLimit Int      @default(200)
  smtpHost    String   @default("smtp.ethereal.email")
  smtpPort    Int      @default(587)
  smtpUser    String
  smtpPass    String
  emails      Email[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Email {
  id                 String   @id @default(uuid())
  recipient          String
  subject            String
  body               String
  status             String   @default("SCHEDULED")
  scheduledAt        DateTime
  sentAt             DateTime?
  attempts           Int      @default(0)
  sendingStartedAt   DateTime? @map("sending_started_at")
  messageId          String?  @map("message_id")
  delayBetweenSec    Int      @default(2)
  delayBetweenMs     Int?     @map("delay_between_ms")
  hourlyLimit       Int?     @map("hourly_limit")
  rateLimitReservedWindowStartMs BigInt? @map("rate_limit_reserved_window_start_ms")
  idempotencyKey     String
  etherealPreviewUrl String?
  failureReason      String?
  
  senderId           String
  sender             Sender   @relation(fields: [senderId], references: [id])
  
  userId             String?
  user               User?    @relation(fields: [userId], references: [id])
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([senderId])
  @@unique([userId, idempotencyKey])
}

model RateLimitLog {
  id         String   @id @default(uuid())
  senderId   String
  hourWindow String
  count      Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([senderId, hourWindow])
}
